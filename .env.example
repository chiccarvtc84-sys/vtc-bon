# ============================================================================
# TRAJETPRO - Variables d'environnement
# ============================================================================
# Copier ce fichier en `.env` (à la racine du projet, PAS dans src/)
# Remplacer les valeurs par les vraies clés
# Le fichier .env est dans .gitignore (NE JAMAIS le commiter)
# ============================================================================

# --- Supabase ---
# À récupérer dans : Supabase Dashboard → Project Settings → API
# (Ne PAS commiter l'URL réelle d'un projet de prod ici, juste un placeholder)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXXXXXX

# --- Stripe (Phase 5) ---
# À récupérer dans : Stripe Dashboard → Développeurs → Clés API
# Mode TEST pour développement, mode LIVE pour production
VITE_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# --- RevenueCat (achat de jetons via Apple In-App Purchase, iOS uniquement) ---
# À récupérer dans : RevenueCat Dashboard → Project settings → API keys → Apple
# Clé PUBLIQUE (appl_...), sûre à exposer côté client comme VITE_STRIPE_PUBLIC_KEY.
VITE_REVENUECAT_API_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXX

# --- Configuration métier ---
VITE_APP_NAME=TrajetPro
VITE_APP_VERSION=1.0.0
VITE_DRIVER_VAT_RATE=10
VITE_INITIAL_TOKEN_BALANCE=5

# --- Optionnel : Sentry pour le monitoring d'erreurs en prod ---
# VITE_SENTRY_DSN=https://XXXXX@oXXXXX.ingest.sentry.io/XXXXX

# ============================================================================
# CÔTÉ SERVEUR (à configurer dans Supabase Edge Functions Secrets)
# Ne PAS mettre dans .env client !
# ============================================================================
# STRIPE_SECRET_KEY=sk_test_XXXXXXXX (côté serveur uniquement)
# STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXX (côté serveur uniquement)
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (côté serveur uniquement, NE JAMAIS exposer côté client)
# GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXX (Edge Function voice-extract — Gemini 2.0 Flash)
#                                              Récupérer sur https://aistudio.google.com/app/apikey
#                                              Modèle utilisé : gemini-2.0-flash (free tier généreux)
